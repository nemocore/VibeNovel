# ---------------------------------------------------------------------------
# VibeNovel deployment template
# Copy to .env and replace every placeholder before starting the container.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Single-user login. Quote values containing #, spaces, or symbols; an
# unquoted # starts a comment in .env parsers.
APP_USERNAME=writer
APP_PASSWORD="change-this-password"

# 32+ random characters. Generate with: openssl rand -base64 32
SESSION_SECRET=

# AI provider API keys are entered in the app (Setup -> Providers) and stored
# in the local SQLite database, not in this file.
# Example placeholders for reference only:
# OPENROUTER_API_KEY=your_api_key_here
# NANOGPT_API_KEY=your_api_key_here

# Local development uses ./data. Docker Compose overrides this to /data and
# persists that path through the ./data host bind mount.
DATA_DIR=./data

# Optional comma-separated extra hostnames allowed to load Next.js dev
# resources. Private LAN ranges are already allowed in development.
# Example: writer.local,192.168.1.50
ALLOWED_DEV_ORIGINS=

